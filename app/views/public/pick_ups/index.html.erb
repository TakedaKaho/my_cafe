<div class="container">
  <div class="row">
    <div class="col-lg-3">
      <h4 class="text-center bg-secondary text-white p-2">過去のPickUp一覧</h4>
      <div class="list-group mt-3">
        <% @pick_ups.each do |pick_up| %>
          <a href="<%= pick_up_path(pick_up.id) %>" class="list-group-item list-group-item-action">
            <strong><%= pick_up.created_at.strftime("%Y-%m-%d") %></strong><br>
            <%= pick_up.title %>
          </a>
        <% end %>
      </div>
      <div class="pagination justify-content-center mt-3">
        <%= paginate @pick_ups, theme: 'twitter-bootstrap-4' %>
      </div>
    </div>
    
    <div class="col-lg-9">
      <h3 class="text-center bg-dark text-white p-3" style="font-family: 'Arial', sans-serif;"><i class="fa-solid fa-check"></i> 今 週 の P i c k U p C a f e</h3>
      
      <% if @latest_pick_up.present? %>
        <div class="row mb-4 mt-4">
          <div class="col-md-12">
            <div class="card" style="background-color: #F0F8FF;">
              <div class="card-body">
                <div class="row justify-content-center">
                  <h3 class="card-title", style="font-family: 'Arial', sans-serif;">『 <%= @latest_pick_up.title %> 』</h3>
                  
                  <% if @latest_pick_up.pick_up_images.attached? %>
                    <div class="mt-2">
                      <% @latest_pick_up.pick_up_images.each do |image| %>
                        <%= image_tag url_for(image), class: "mb-3", style: "width: 260px; height: 180px; object-fit: cover;" %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <h3 class="card-text mb-2" style="font-family: 'Times New Roman', sans-serif; padding: 5px;">今週のPickUp Cafe『 <%= @latest_pick_up.post.name %> 』</h3>
                    <h5 class="card-text bg-white text-center mt-2" style="padding: 15px;"><%= @latest_pick_up.body.gsub(/\n/, '<br>').html_safe %></h5>
                    <div class="mt-3 d-flex justify-content-end">
                      <%= link_to post_path(@latest_pick_up.post), class: "btn btn-dark" do %>
                        <%= @latest_pick_up.post.name %>の詳細を見る <i class="fa-solid fa-mug-hot" style="color: #ffffff;"></i>
                      <% end %>
                    </div>
                  </div>
                </div>
                
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

  

